# Runtime
NODE_ENV=production
APP_ENV=production
PORT=3000
APP_URL=https://yourdomain.com
TRUST_PROXY=true
MAINTENANCE_MODE=false

# Sessions
# Use a long random value in production.
SESSION_SECRET=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=impactmis
DB_CONNECTION_LIMIT=5

# Runtime storage
UPLOAD_ROOT=public/uploads
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=14
LOG_DIR=storage/logs

# First developer admin seed
DEV_ADMIN_NAME=Developer Admin
DEV_ADMIN_EMAIL=admin@impactmis.local
DEV_ADMIN_PASSWORD=ChangeMe123!

# Demo/pilot tenant seed
DEMO_TENANT_CODE=DEMO-NGO
DEMO_TENANT_NAME=Demo NGO
DEMO_ADMIN_EMAIL=tenantadmin@demo.local
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_DONOR_EMAIL=donor@demo.local
DEMO_DONOR_PASSWORD=ChangeMe123!
