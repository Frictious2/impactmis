<section class="card section-card">
  <div class="card-body">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
      <div>
        <h1 class="h4 mb-1">Self Check-In</h1>
        <p class="text-muted mb-0">Use your current GPS location to check in from your assigned branch attendance area.</p>
      </div>
      <div>
        <a href="/attendance" class="btn btn-outline-secondary">Back to Attendance</a>
      </div>
    </div>

    <% if (!linkedStaffMember) { %>
      <div class="alert alert-warning mb-0">
        No active staff or volunteer profile is linked to your current account email.
      </div>
    <% } else if (!branch) { %>
      <div class="alert alert-warning mb-0">
        Your staff profile does not have an active branch assignment yet. Contact your tenant administrator.
      </div>
    <% } else { %>
      <div class="row g-4">
        <div class="col-lg-5">
          <section class="border rounded-3 p-3 h-100 bg-light-subtle">
            <h2 class="h6 text-uppercase text-muted mb-3">Assigned Profile</h2>
            <dl class="row mb-0">
              <dt class="col-sm-5">Staff</dt>
              <dd class="col-sm-7"><%= linkedStaffMember.full_name %></dd>
              <dt class="col-sm-5">Staff Code</dt>
              <dd class="col-sm-7"><%= linkedStaffMember.staff_code %></dd>
              <dt class="col-sm-5">Branch</dt>
              <dd class="col-sm-7"><%= branch.name %></dd>
              <dt class="col-sm-5">Geofence Radius</dt>
              <dd class="col-sm-7"><%= branch.geofence_radius_meters %> m</dd>
            </dl>
          </section>
        </div>
        <div class="col-lg-7">
          <form id="selfCheckinForm" action="/attendance/self-checkin" method="POST" class="d-flex flex-column gap-3">
            <input type="hidden" id="latitude" name="latitude" />
            <input type="hidden" id="longitude" name="longitude" />
            <input type="hidden" id="device_info" name="device_info" />
            <div>
              <label for="location" class="form-label">Location Label</label>
              <input id="location" name="location" type="text" class="form-control" placeholder="Optional site note, landmark, or office room" />
            </div>
            <div>
              <label for="notes" class="form-label">Notes</label>
              <textarea id="notes" name="notes" class="form-control" rows="3" placeholder="Optional note for today's attendance"></textarea>
            </div>
            <div id="geoStatus" class="alert alert-secondary mb-0">
              Click the button below to request GPS access and capture your check-in.
            </div>
            <div class="d-flex gap-2">
              <button type="button" id="checkInButton" class="btn btn-primary">Check In</button>
              <a href="/attendance" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
      <script>
        (function () {
          var button = document.getElementById("checkInButton");
          var statusBox = document.getElementById("geoStatus");
          var latitudeField = document.getElementById("latitude");
          var longitudeField = document.getElementById("longitude");
          var deviceInfoField = document.getElementById("device_info");
          var form = document.getElementById("selfCheckinForm");

          if (!button || !statusBox || !form) {
            return;
          }

          button.addEventListener("click", function () {
            if (!navigator.geolocation) {
              statusBox.className = "alert alert-danger mb-0";
              statusBox.textContent = "Geolocation is not supported by this browser.";
              return;
            }

            button.disabled = true;
            statusBox.className = "alert alert-info mb-0";
            statusBox.textContent = "Requesting GPS location...";

            navigator.geolocation.getCurrentPosition(
              function (position) {
                latitudeField.value = position.coords.latitude;
                longitudeField.value = position.coords.longitude;
                deviceInfoField.value = navigator.userAgent || "";
                statusBox.className = "alert alert-success mb-0";
                statusBox.textContent = "Location captured. Submitting self check-in...";
                form.submit();
              },
              function (error) {
                button.disabled = false;
                statusBox.className = "alert alert-danger mb-0";
                statusBox.textContent = error && error.message
                  ? error.message
                  : "Unable to capture your location.";
              },
              {
                enableHighAccuracy: true,
                timeout: 15000,
                maximumAge: 0
              }
            );
          });
        })();
      </script>
    <% } %>
  </div>
</section>
