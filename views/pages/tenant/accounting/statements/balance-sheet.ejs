<section class="mb-4"><h1 class="h4 mb-1">Balance Sheet</h1><p class="text-muted mb-0">Simple asset, liability, and equity balances from posted journals.</p></section>
<div class="row g-4">
  <div class="col-lg-4"><section class="card border-0 shadow-sm"><div class="card-header bg-white fw-semibold">Assets</div><div class="table-responsive"><table class="table mb-0"><tbody><% assets.forEach((row) => { %><tr><td><%= row.account_code %> - <%= row.account_name %></td><td class="text-end"><%= money(row.amount) %></td></tr><% }) %><% if (!assets.length) { %><tr><td class="text-muted py-4">No assets.</td></tr><% } %></tbody><tfoot class="table-light"><tr><th>Total Assets</th><th class="text-end"><%= money(totalAssets) %></th></tr></tfoot></table></div></section></div>
  <div class="col-lg-4"><section class="card border-0 shadow-sm"><div class="card-header bg-white fw-semibold">Liabilities</div><div class="table-responsive"><table class="table mb-0"><tbody><% liabilities.forEach((row) => { %><tr><td><%= row.account_code %> - <%= row.account_name %></td><td class="text-end"><%= money(row.amount) %></td></tr><% }) %><% if (!liabilities.length) { %><tr><td class="text-muted py-4">No liabilities.</td></tr><% } %></tbody><tfoot class="table-light"><tr><th>Total Liabilities</th><th class="text-end"><%= money(totalLiabilities) %></th></tr></tfoot></table></div></section></div>
  <div class="col-lg-4"><section class="card border-0 shadow-sm"><div class="card-header bg-white fw-semibold">Equity</div><div class="table-responsive"><table class="table mb-0"><tbody><% equity.forEach((row) => { %><tr><td><%= row.account_code %> - <%= row.account_name %></td><td class="text-end"><%= money(row.amount) %></td></tr><% }) %><% if (!equity.length) { %><tr><td class="text-muted py-4">No equity.</td></tr><% } %></tbody><tfoot class="table-light"><tr><th>Total Equity</th><th class="text-end"><%= money(totalEquity) %></th></tr></tfoot></table></div></section></div>
</div>
