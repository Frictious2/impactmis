<section class="mb-4"><h1 class="h4 mb-1">Trial Balance</h1><p class="text-muted mb-0">Calculated from posted journal entries only.</p></section>
<section class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0">
  <thead class="table-light"><tr><th>Code</th><th>Account</th><th>Type</th><th>Debit Balance</th><th>Credit Balance</th></tr></thead>
  <tbody>
    <% if (!rows.length) { %><tr><td colspan="5" class="text-center text-muted py-5">No accounts found.</td></tr><% } %>
    <% let debitTotal = 0; let creditTotal = 0; rows.forEach((row) => { debitTotal += Number(row.debit_balance || 0); creditTotal += Number(row.credit_balance || 0); %>
      <tr><td><%= row.account_code %></td><td><%= row.account_name %></td><td><%= row.account_type %></td><td><%= money(row.debit_balance) %></td><td><%= money(row.credit_balance) %></td></tr>
    <% }) %>
  </tbody>
  <tfoot class="table-light"><tr><th colspan="3" class="text-end">Totals</th><th><%= money(debitTotal) %></th><th><%= money(creditTotal) %></th></tr></tfoot>
</table></div></section>
