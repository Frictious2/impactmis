<section class="mb-4"><h1 class="h4 mb-1">Income Statement</h1><p class="text-muted mb-0">Simple income and expense view from posted journals.</p></section>
<div class="row g-4">
  <div class="col-lg-6"><section class="card border-0 shadow-sm"><div class="card-header bg-white fw-semibold">Income</div><div class="table-responsive"><table class="table mb-0"><tbody><% if (!income.length) { %><tr><td class="text-muted py-4">No income accounts.</td></tr><% } %><% income.forEach((row) => { %><tr><td><%= row.account_code %> - <%= row.account_name %></td><td class="text-end"><%= money(row.amount) %></td></tr><% }) %></tbody><tfoot class="table-light"><tr><th>Total Income</th><th class="text-end"><%= money(totalIncome) %></th></tr></tfoot></table></div></section></div>
  <div class="col-lg-6"><section class="card border-0 shadow-sm"><div class="card-header bg-white fw-semibold">Expenses</div><div class="table-responsive"><table class="table mb-0"><tbody><% if (!expenses.length) { %><tr><td class="text-muted py-4">No expense accounts.</td></tr><% } %><% expenses.forEach((row) => { %><tr><td><%= row.account_code %> - <%= row.account_name %></td><td class="text-end"><%= money(row.amount) %></td></tr><% }) %></tbody><tfoot class="table-light"><tr><th>Total Expenses</th><th class="text-end"><%= money(totalExpenses) %></th></tr></tfoot></table></div></section></div>
</div>
<section class="card border-0 shadow-sm mt-4"><div class="card-body d-flex justify-content-between"><span class="fw-semibold">Net Surplus / Deficit</span><span class="fw-bold"><%= money(netSurplus) %></span></div></section>
