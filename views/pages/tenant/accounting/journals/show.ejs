<section class="d-flex justify-content-between align-items-start mb-4">
  <div><h1 class="h4 mb-1"><%= journal.journal_number %></h1><p class="text-muted mb-0"><%= formatDate(journal.journal_date) %> · <span class="badge text-bg-<%= statusBadge(journal.status) %>"><%= journal.status %></span></p></div>
  <div class="d-flex gap-2">
    <% if (journal.status === 'draft') { %><a class="btn btn-outline-secondary" href="/accounting/journals/<%= journal.id %>/edit">Edit</a><form method="post" action="/accounting/journals/<%= journal.id %>/post"><button class="btn btn-success" type="submit">Post</button></form><% } %>
    <% if (journal.status !== 'cancelled') { %><form method="post" action="/accounting/journals/<%= journal.id %>/cancel"><button class="btn btn-outline-danger" type="submit">Cancel</button></form><% } %>
  </div>
</section>
<section class="card border-0 shadow-sm mb-4"><div class="card-body"><p class="mb-0"><%= journal.description %></p></div></section>
<section class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0">
  <thead class="table-light"><tr><th>Account</th><th>Description</th><th>Project</th><th>Branch</th><th>Debit</th><th>Credit</th></tr></thead>
  <tbody>
    <% lines.forEach((line) => { %><tr><td><%= line.account_code %> - <%= line.account_name %></td><td><%= line.description || '' %></td><td><%= line.project_name || 'None' %></td><td><%= line.branch_name || 'None' %></td><td><%= money(line.debit) %></td><td><%= money(line.credit) %></td></tr><% }) %>
  </tbody>
  <tfoot class="table-light"><tr><th colspan="4" class="text-end">Totals</th><th><%= money(journal.total_debit) %></th><th><%= money(journal.total_credit) %></th></tr></tfoot>
</table></div></section>
