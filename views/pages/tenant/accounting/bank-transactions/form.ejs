<section class="d-flex justify-content-between align-items-start mb-4">
  <div><h1 class="h4 mb-1">Create Bank Transaction</h1><p class="text-muted mb-0">Posting will create a balanced journal entry automatically.</p></div>
  <a class="btn btn-outline-secondary" href="/accounting/bank-transactions">Back to Transactions</a>
</section>
<section class="card border-0 shadow-sm"><div class="card-body">
  <form method="post" action="<%= formAction %>" class="row g-3">
    <div class="col-md-4"><label class="form-label">Bank Account</label><select class="form-select" name="bank_account_id" required><option value="">Select bank account</option><% bankAccounts.forEach((account) => { %><option value="<%= account.id %>"><%= account.account_name %></option><% }) %></select></div>
    <div class="col-md-4"><label class="form-label">Transaction Type</label><select class="form-select" name="transaction_type" required><% transactionTypes.forEach((type) => { %><option value="<%= type.value %>"><%= type.label %></option><% }) %></select></div>
    <div class="col-md-4"><label class="form-label">Transaction Date</label><input class="form-control" type="date" name="transaction_date" value="<%= formatDate(transaction.transaction_date) %>" required></div>
    <div class="col-md-8"><label class="form-label">Description</label><input class="form-control" name="description" required></div>
    <div class="col-md-4"><label class="form-label">Amount</label><input class="form-control" type="number" step="0.01" min="0.01" name="amount" required></div>
    <div class="col-md-8"><label class="form-label">Offset GL Account</label><select class="form-select" name="offset_account_id" required><option value="">Select offset account</option><% accounts.forEach((account) => { %><option value="<%= account.id %>"><%= account.account_code %> - <%= account.account_name %> (<%= account.account_type %>)</option><% }) %></select><div class="form-text">Deposit offsets: income/liability/equity. Withdrawal offsets: expense/asset. Transfer offsets: asset.</div></div>
    <div class="col-md-4"><label class="form-label">Reference Number</label><input class="form-control" name="reference_number"></div>
    <div class="col-12"><button class="btn btn-success" type="submit">Create Transaction</button></div>
  </form>
</div></section>
