<% const validationMap = {}; %>
<% (validationErrors || []).forEach((error) => { validationMap[error.path] = error.msg; }); %>
<form method="post" action="<%= formAction %>" enctype="multipart/form-data" class="d-flex flex-column gap-4">
  <section class="card border-0 shadow-sm"><div class="card-body">
    <h1 class="h4 mb-3"><%= formTitle %></h1>
    <div class="row g-3">
      <div class="col-md-4"><label class="form-label">Expense Date</label><input class="form-control <%= validationMap.expense_date ? 'is-invalid' : '' %>" name="expense_date" type="date" value="<%= formData.expense_date %>" required><% if (validationMap.expense_date) { %><div class="invalid-feedback"><%= validationMap.expense_date %></div><% } %></div>
      <div class="col-md-4"><label class="form-label">Category</label><select class="form-select <%= validationMap.category_id ? 'is-invalid' : '' %>" name="category_id" required><option value="">Select category</option><% categories.forEach((category) => { %><option value="<%= category.id %>" <%= String(formData.category_id) === String(category.id) ? 'selected' : '' %>><%= category.name %> (<%= category.code %>)</option><% }) %></select><% if (validationMap.category_id) { %><div class="invalid-feedback"><%= validationMap.category_id %></div><% } %></div>
      <div class="col-md-4"><label class="form-label">Amount</label><input class="form-control <%= validationMap.amount ? 'is-invalid' : '' %>" name="amount" type="number" min="0.01" step="0.01" value="<%= formData.amount %>" required><% if (validationMap.amount) { %><div class="invalid-feedback"><%= validationMap.amount %></div><% } %></div>
      <div class="col-md-6"><label class="form-label">Project</label><select class="form-select" name="project_id"><option value="">No project</option><% projects.forEach((project) => { %><option value="<%= project.id %>" <%= String(formData.project_id) === String(project.id) ? 'selected' : '' %>><%= project.project_code %> - <%= project.project_name %></option><% }) %></select></div>
      <div class="col-md-6"><label class="form-label">Branch</label><select class="form-select" name="branch_id"><option value="">No branch</option><% branches.forEach((branch) => { %><option value="<%= branch.id %>" <%= String(formData.branch_id) === String(branch.id) ? 'selected' : '' %>><%= branch.branch_code %> - <%= branch.name %></option><% }) %></select></div>
      <div class="col-md-6"><label class="form-label">Vendor Name</label><input class="form-control" name="vendor_name" value="<%= formData.vendor_name %>"></div>
      <div class="col-md-6"><label class="form-label">Payment Method</label><select class="form-select" name="payment_method"><% paymentMethodOptions.forEach((option) => { %><option value="<%= option.value %>" <%= formData.payment_method === option.value ? 'selected' : '' %>><%= option.label %></option><% }) %></select></div>
      <div class="col-md-6"><label class="form-label">Receipt Number</label><input class="form-control" name="receipt_number" value="<%= formData.receipt_number %>"></div>
      <div class="col-md-6"><label class="form-label">Receipt File</label><input class="form-control" name="receipt_file" type="file" accept="image/jpeg,image/png,image/webp,application/pdf"></div>
      <div class="col-12"><label class="form-label">Description</label><textarea class="form-control <%= validationMap.description ? 'is-invalid' : '' %>" name="description" rows="4" required><%= formData.description %></textarea><% if (validationMap.description) { %><div class="invalid-feedback"><%= validationMap.description %></div><% } %></div>
    </div>
  </div></section>
  <div class="d-flex gap-2"><button class="btn btn-success" type="submit"><%= submitLabel %></button><a class="btn btn-outline-secondary" href="<%= cancelHref %>">Cancel</a></div>
</form>
