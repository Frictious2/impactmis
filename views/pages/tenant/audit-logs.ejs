<section class="card section-card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h4 mb-1">Organization Audit Logs</h1>
        <p class="text-muted mb-0">Shows operational activity within your organization only.</p>
      </div>
    </div>

    <% if (!logs.length) { %>
      <p class="text-muted mb-0">No audit logs are available yet.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Action</th>
              <th>Actor</th>
              <th>Entity</th>
              <th>Metadata</th>
              <th>When</th>
            </tr>
          </thead>
          <tbody>
            <% logs.forEach((log) => { %>
              <tr>
                <td><span class="fw-semibold"><%= log.action %></span></td>
                <td><%= log.user_name || 'System' %></td>
                <td><%= log.entity_type %> <%= log.entity_id ? `#${log.entity_id}` : '' %></td>
                <td><code class="small"><%= log.metadata_json ? JSON.stringify(log.metadata_json) : '—' %></code></td>
                <td><%= new Date(log.created_at).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
