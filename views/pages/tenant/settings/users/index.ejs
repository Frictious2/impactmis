<section class="card section-card">
  <div class="card-body">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
      <div>
        <h1 class="h4 mb-1">Tenant Users</h1>
        <p class="text-muted mb-0">Manage tenant user accounts, role assignments, and department placement.</p>
      </div>
      <div>
        <a href="/settings/users/create" class="btn btn-primary">Create User</a>
      </div>
    </div>

    <% if (!users.length) { %>
      <p class="text-muted mb-0">No tenant users have been created yet.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Role</th>
              <th>Department</th>
              <th>Status</th>
              <th>Last Login</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((user) => { %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= user.full_name %></div>
                  <div class="small text-muted"><%= user.email %></div>
                </td>
                <td><%= user.role %></td>
                <td><%= user.department_name || 'Unassigned' %></td>
                <td><span class="badge rounded-pill <%= user.status === 'active' ? 'badge-soft-success' : 'badge-soft-danger' %>"><%= user.status %></span></td>
                <td><%= user.last_login_at ? new Date(user.last_login_at).toLocaleString() : 'Never' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
