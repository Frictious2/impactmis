<section class="d-flex justify-content-between align-items-start mb-4">
  <div><h1 class="h4 mb-1"><%= form.title %></h1><p class="text-muted mb-0"><%= form.description || 'No description.' %></p></div>
  <div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/surveys/<%= form.id %>/responses">Responses</a><% if (form.status === 'published') { %><a class="btn btn-success" href="/surveys/<%= form.id %>/respond">Respond</a><% } %></div>
</section>
<section class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="d-flex justify-content-between"><span>Status: <span class="badge text-bg-<%= form.status === 'published' ? 'success' : 'secondary' %>"><%= form.status %></span></span><% if (form.status === 'draft') { %><form method="post" action="/surveys/<%= form.id %>/publish"><button class="btn btn-sm btn-success" type="submit">Publish</button></form><% } %></div></div></section>
<div class="row g-4">
  <div class="col-lg-8"><section class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0 align-middle"><thead class="table-light"><tr><th>#</th><th>Question</th><th>Type</th><th>Required</th></tr></thead><tbody><% if (!questions.length) { %><tr><td colspan="4" class="text-center text-muted py-5">No questions yet.</td></tr><% } %><% questions.forEach((q, i) => { %><tr><td><%= i + 1 %></td><td><%= q.question_text %></td><td><%= q.question_type %></td><td><%= q.required ? 'Yes' : 'No' %></td></tr><% }) %></tbody></table></div></section></div>
  <% if (form.status === 'draft') { %><div class="col-lg-4"><section class="card border-0 shadow-sm"><div class="card-body"><h2 class="h6">Add Question</h2><form method="post" action="/surveys/<%= form.id %>/questions" class="row g-3"><div class="col-12"><label class="form-label">Question</label><textarea class="form-control" name="question_text" required></textarea></div><div class="col-12"><label class="form-label">Type</label><select class="form-select" name="question_type"><% ['short_text','long_text','number','single_choice','multiple_choice','yes_no','date'].forEach((type) => { %><option value="<%= type %>"><%= type.replace('_',' ') %></option><% }) %></select></div><div class="col-12"><label class="form-label">Options</label><textarea class="form-control" name="options_text" rows="3" placeholder="For choice questions, one option per line"></textarea></div><div class="col-6"><label class="form-label">Sort</label><input class="form-control" type="number" name="sort_order" value="<%= questions.length + 1 %>"></div><div class="col-6"><label class="form-label">Required</label><select class="form-select" name="required"><option value="1">Yes</option><option value="0">No</option></select></div><div class="col-12"><button class="btn btn-success" type="submit">Add Question</button></div></form></div></section></div><% } %>
</div>
