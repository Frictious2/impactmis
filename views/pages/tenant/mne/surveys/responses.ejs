<section class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="h4 mb-1">Survey Analytics</h1><p class="text-muted mb-0"><%= form.title %></p></div><a class="btn btn-outline-secondary" href="/surveys/<%= form.id %>">Back to Survey</a></section>
<section class="row g-3 mb-4"><div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Total Responses</div><div class="display-6 fw-semibold"><%= responses.length %></div></div></div></div></section>
<div class="row g-4">
  <div class="col-lg-7"><section class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead class="table-light"><tr><th>Date</th><th>Submitted By</th><th>Branch</th></tr></thead><tbody><% if (!responses.length) { %><tr><td colspan="3" class="text-center text-muted py-5">No responses yet.</td></tr><% } %><% responses.forEach((r) => { %><tr><td><%= new Date(r.submitted_at).toISOString().slice(0,16).replace('T',' ') %></td><td><%= r.submitted_by_name || 'Anonymous' %></td><td><%= r.branch_name || 'None' %></td></tr><% }) %></tbody></table></div></section></div>
  <div class="col-lg-5"><section class="card border-0 shadow-sm"><div class="card-body"><h2 class="h6">Summary</h2><% summary.forEach((item) => { %><div class="border-top pt-3 mt-3"><div class="fw-semibold"><%= item.question.question_text %></div><% if (item.average !== undefined) { %><div>Average: <strong><%= Number(item.average || 0).toFixed(2) %></strong> from <%= item.count %> answers</div><% } else { %><% Object.keys(item.frequencies || {}).forEach((key) => { %><div class="d-flex justify-content-between"><span><%= key %></span><span><%= item.frequencies[key] %></span></div><% }) %><% } %></div><% }) %></div></section></div>
</div>
