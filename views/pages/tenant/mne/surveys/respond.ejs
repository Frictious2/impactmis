<section class="mb-4"><h1 class="h4 mb-1"><%= form.title %></h1><p class="text-muted mb-0"><%= form.description || 'Complete the survey below.' %></p></section>
<section class="card border-0 shadow-sm"><div class="card-body"><form method="post" action="/surveys/<%= form.id %>/respond" class="row g-3">
  <div class="col-md-6"><label class="form-label">Branch</label><select class="form-select" name="branch_id"><option value="">None</option><% branches.forEach((branch) => { %><option value="<%= branch.id %>"><%= branch.name %></option><% }) %></select></div>
  <% questions.forEach((q) => { %><div class="col-12"><label class="form-label"><%= q.question_text %> <%= q.required ? '*' : '' %></label>
    <% if (q.question_type === 'long_text') { %><textarea class="form-control" name="answers[<%= q.id %>]" <%= q.required ? 'required' : '' %>></textarea>
    <% } else if (q.question_type === 'number') { %><input class="form-control" type="number" step="0.01" name="answers[<%= q.id %>]" <%= q.required ? 'required' : '' %>>
    <% } else if (q.question_type === 'date') { %><input class="form-control" type="date" name="answers[<%= q.id %>]" <%= q.required ? 'required' : '' %>>
    <% } else if (q.question_type === 'yes_no') { %><select class="form-select" name="answers[<%= q.id %>]" <%= q.required ? 'required' : '' %>><option value="">Select</option><option value="Yes">Yes</option><option value="No">No</option></select>
    <% } else if (q.question_type === 'single_choice') { %><select class="form-select" name="answers[<%= q.id %>]" <%= q.required ? 'required' : '' %>><option value="">Select</option><% (q.options_json || []).forEach((option) => { %><option value="<%= option %>"><%= option %></option><% }) %></select>
    <% } else if (q.question_type === 'multiple_choice') { %><% (q.options_json || []).forEach((option) => { %><div class="form-check"><input class="form-check-input" type="checkbox" name="answers[<%= q.id %>][]" value="<%= option %>"><label class="form-check-label"><%= option %></label></div><% }) %>
    <% } else { %><input class="form-control" name="answers[<%= q.id %>]" <%= q.required ? 'required' : '' %>><% } %>
  </div><% }) %>
  <div class="col-12"><button class="btn btn-success" type="submit">Submit Response</button></div>
</form></div></section>
