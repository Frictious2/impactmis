<section class="card section-card mb-4">
  <div class="card-body">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
      <div>
        <h1 class="h4 mb-1">Staff &amp; Volunteers</h1>
        <p class="text-muted mb-0">Manage the tenant's staff, volunteers, consultants, and interns.</p>
      </div>
      <div>
        <a href="/staff/create" class="btn btn-primary">Create Staff Record</a>
      </div>
    </div>

    <form method="GET" action="/staff" class="row g-3 align-items-end">
      <div class="col-lg-4">
        <label for="search" class="form-label">Search</label>
        <input id="search" name="search" type="text" class="form-control" placeholder="Code, name, or email" value="<%= filters.search %>" />
      </div>
      <div class="col-md-3 col-lg-2">
        <label for="department_id" class="form-label">Department</label>
        <select id="department_id" name="department_id" class="form-select">
          <option value="">All</option>
          <% departments.forEach((department) => { %>
            <option value="<%= department.id %>" <%= String(filters.department_id) === String(department.id) ? 'selected' : '' %>><%= department.department_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3 col-lg-2">
        <label for="employment_type" class="form-label">Type</label>
        <select id="employment_type" name="employment_type" class="form-select">
          <option value="">All</option>
          <% employmentTypeOptions.forEach((option) => { %>
            <option value="<%= option.value %>" <%= filters.employment_type === option.value ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3 col-lg-2">
        <label for="status" class="form-label">Status</label>
        <select id="status" name="status" class="form-select">
          <option value="">All</option>
          <% statusOptions.forEach((option) => { %>
            <option value="<%= option.value %>" <%= filters.status === option.value ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3 col-lg-2 d-flex gap-2">
        <button type="submit" class="btn btn-dark flex-grow-1">Filter</button>
        <a href="/staff" class="btn btn-outline-secondary">Reset</a>
      </div>
    </form>
  </div>
</section>

<section class="card section-card">
  <div class="card-body p-0">
    <% if (!staffMembers.length) { %>
      <div class="p-4">
        <h2 class="h5">No staff records found</h2>
        <p class="text-muted mb-3">Create the first staff or volunteer record for this tenant.</p>
        <a href="/staff/create" class="btn btn-primary">Create Staff Record</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Staff Code</th>
              <th>Full Name</th>
              <th>Type</th>
              <th>Department</th>
              <th>Position</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% staffMembers.forEach((staffMember) => { %>
              <tr>
                <td class="fw-semibold"><%= staffMember.staff_code %></td>
                <td><%= staffMember.full_name %></td>
                <td class="text-capitalize"><%= staffMember.employment_type %></td>
                <td><%= staffMember.department_name || 'Unassigned' %></td>
                <td><%= staffMember.position_title %></td>
                <td><%= staffMember.phone || '—' %></td>
                <td><%= staffMember.email || '—' %></td>
                <td>
                  <span class="badge rounded-pill <%= staffMember.status === 'active' ? 'badge-soft-success' : staffMember.status === 'inactive' ? 'badge-soft-warning' : 'badge-soft-danger' %>">
                    <%= staffMember.status %>
                  </span>
                </td>
                <td class="text-end">
                  <div class="d-flex flex-column gap-2 align-items-end">
                    <div class="d-flex gap-2">
                      <a href="/staff/<%= staffMember.id %>" class="btn btn-sm btn-outline-primary">View</a>
                      <a href="/staff/<%= staffMember.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </div>
                    <form action="/staff/<%= staffMember.id %>/status" method="POST" class="d-flex gap-2 align-items-center">
                      <select name="next_status" class="form-select form-select-sm">
                        <% statusOptions.forEach((option) => { %>
                          <option value="<%= option.value %>" <%= staffMember.status === option.value ? 'selected' : '' %>><%= option.label %></option>
                        <% }) %>
                      </select>
                      <input name="status_end_date" type="date" class="form-control form-control-sm" value="<%= staffMember.end_date ? String(staffMember.end_date).slice(0, 10) : '' %>" />
                      <button type="submit" class="btn btn-sm btn-outline-dark">Update</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
