<% const validationMap = {}; %>
<% (validationErrors || []).forEach((error) => { validationMap[error.path] = error.msg; }); %>

<form action="<%= formAction %>" method="POST" class="d-flex flex-column gap-4">
  <section class="card section-card">
    <div class="card-body">
      <h1 class="h4 mb-3"><%= formTitle %></h1>
      <div class="row g-3">
        <div class="col-12">
          <h2 class="h6 text-uppercase text-muted">Project Information</h2>
        </div>
        <div class="col-md-4">
          <label for="project_code" class="form-label">Project Code</label>
          <input id="project_code" name="project_code" type="text" class="form-control <%= validationMap.project_code ? 'is-invalid' : '' %>" value="<%= formData.project_code %>" />
          <% if (validationMap.project_code) { %><div class="invalid-feedback"><%= validationMap.project_code %></div><% } %>
        </div>
        <div class="col-md-8">
          <label for="project_name" class="form-label">Project Name</label>
          <input id="project_name" name="project_name" type="text" class="form-control <%= validationMap.project_name ? 'is-invalid' : '' %>" value="<%= formData.project_name %>" />
          <% if (validationMap.project_name) { %><div class="invalid-feedback"><%= validationMap.project_name %></div><% } %>
        </div>
        <div class="col-12">
          <label for="project_description" class="form-label">Project Description</label>
          <textarea id="project_description" name="project_description" class="form-control <%= validationMap.project_description ? 'is-invalid' : '' %>" rows="4"><%= formData.project_description %></textarea>
          <% if (validationMap.project_description) { %><div class="invalid-feedback"><%= validationMap.project_description %></div><% } %>
        </div>
      </div>
    </div>
  </section>

  <section class="card section-card">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12">
          <h2 class="h6 text-uppercase text-muted">Assignment Information</h2>
        </div>
        <div class="col-md-6">
          <label for="branch_id" class="form-label">Branch</label>
          <select id="branch_id" name="branch_id" class="form-select <%= validationMap.branch_id ? 'is-invalid' : '' %>">
            <option value="">Unassigned</option>
            <% branches.forEach((branch) => { %>
              <option value="<%= branch.id %>" <%= String(formData.branch_id) === String(branch.id) ? 'selected' : '' %>><%= branch.branch_code %> - <%= branch.name %></option>
            <% }) %>
          </select>
          <% if (validationMap.branch_id) { %><div class="invalid-feedback"><%= validationMap.branch_id %></div><% } %>
        </div>
        <div class="col-md-6">
          <label for="project_manager_id" class="form-label">Project Manager</label>
          <select id="project_manager_id" name="project_manager_id" class="form-select <%= validationMap.project_manager_id ? 'is-invalid' : '' %>">
            <option value="">Unassigned</option>
            <% managers.forEach((manager) => { %>
              <option value="<%= manager.id %>" <%= String(formData.project_manager_id) === String(manager.id) ? 'selected' : '' %>><%= manager.full_name %> (<%= manager.role %>)</option>
            <% }) %>
          </select>
          <% if (validationMap.project_manager_id) { %><div class="invalid-feedback"><%= validationMap.project_manager_id %></div><% } %>
        </div>
      </div>
    </div>
  </section>

  <section class="card section-card">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12">
          <h2 class="h6 text-uppercase text-muted">Funding Information</h2>
        </div>
        <div class="col-md-6">
          <label for="donor_name" class="form-label">Donor Name</label>
          <input id="donor_name" name="donor_name" type="text" class="form-control" value="<%= formData.donor_name %>" />
        </div>
        <div class="col-md-6">
          <label for="budget" class="form-label">Budget</label>
          <input id="budget" name="budget" type="number" step="0.01" min="0" class="form-control <%= validationMap.budget ? 'is-invalid' : '' %>" value="<%= formData.budget %>" />
          <% if (validationMap.budget) { %><div class="invalid-feedback"><%= validationMap.budget %></div><% } %>
        </div>
      </div>
    </div>
  </section>

  <section class="card section-card">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12">
          <h2 class="h6 text-uppercase text-muted">Timeline</h2>
        </div>
        <div class="col-md-4">
          <label for="start_date" class="form-label">Start Date</label>
          <input id="start_date" name="start_date" type="date" class="form-control <%= validationMap.start_date ? 'is-invalid' : '' %>" value="<%= formData.start_date %>" />
          <% if (validationMap.start_date) { %><div class="invalid-feedback"><%= validationMap.start_date %></div><% } %>
        </div>
        <div class="col-md-4">
          <label for="end_date" class="form-label">End Date</label>
          <input id="end_date" name="end_date" type="date" class="form-control <%= validationMap.end_date ? 'is-invalid' : '' %>" value="<%= formData.end_date %>" />
          <% if (validationMap.end_date) { %><div class="invalid-feedback"><%= validationMap.end_date %></div><% } %>
        </div>
        <div class="col-md-2">
          <label for="status" class="form-label">Status</label>
          <select id="status" name="status" class="form-select <%= validationMap.status ? 'is-invalid' : '' %>">
            <% statusOptions.forEach((option) => { %>
              <option value="<%= option.value %>" <%= formData.status === option.value ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
          <% if (validationMap.status) { %><div class="invalid-feedback"><%= validationMap.status %></div><% } %>
        </div>
        <div class="col-md-2">
          <label for="completion_percentage" class="form-label">Completion %</label>
          <input id="completion_percentage" name="completion_percentage" type="number" min="0" max="100" class="form-control <%= validationMap.completion_percentage ? 'is-invalid' : '' %>" value="<%= formData.completion_percentage %>" />
          <% if (validationMap.completion_percentage) { %><div class="invalid-feedback"><%= validationMap.completion_percentage %></div><% } %>
        </div>
      </div>
    </div>
  </section>

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary"><%= submitLabel %></button>
    <a href="<%= cancelHref %>" class="btn btn-outline-secondary">Cancel</a>
  </div>
</form>
