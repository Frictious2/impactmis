<section class="card section-card mb-4">
  <div class="card-body">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
      <div>
        <h1 class="h4 mb-1">Projects</h1>
        <p class="text-muted mb-0">Track tenant projects, assign staff, and manage foundational delivery tasks.</p>
      </div>
      <div>
        <a href="/projects/create" class="btn btn-primary">Create Project</a>
      </div>
    </div>

    <form method="GET" action="/projects" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label for="status" class="form-label">Status</label>
        <select id="status" name="status" class="form-select">
          <option value="">All</option>
          <% statusOptions.forEach((option) => { %>
            <option value="<%= option.value %>" <%= filters.status === option.value ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label for="branch_id" class="form-label">Branch</label>
        <select id="branch_id" name="branch_id" class="form-select">
          <option value="">All</option>
          <% branches.forEach((branch) => { %>
            <option value="<%= branch.id %>" <%= String(filters.branch_id) === String(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label for="project_manager_id" class="form-label">Manager</label>
        <select id="project_manager_id" name="project_manager_id" class="form-select">
          <option value="">All</option>
          <% managers.forEach((manager) => { %>
            <option value="<%= manager.id %>" <%= String(filters.project_manager_id) === String(manager.id) ? 'selected' : '' %>><%= manager.full_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-dark flex-grow-1">Filter</button>
        <a href="/projects" class="btn btn-outline-secondary">Reset</a>
      </div>
    </form>
  </div>
</section>

<section class="card section-card">
  <div class="card-body p-0">
    <% if (!projects.length) { %>
      <div class="p-4">
        <h2 class="h5">No projects found</h2>
        <p class="text-muted mb-3">Create the first project for this tenant to begin assignments and task planning.</p>
        <a href="/projects/create" class="btn btn-primary">Create Project</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Project Code</th>
              <th>Project Name</th>
              <th>Branch</th>
              <th>Manager</th>
              <th>Budget</th>
              <th>Start Date</th>
              <th>Status</th>
              <th>Completion</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% projects.forEach((project) => { %>
              <tr>
                <td class="fw-semibold"><%= project.project_code %></td>
                <td>
                  <div><%= project.project_name %></div>
                  <div class="small text-muted"><%= project.open_task_count %> open tasks, <%= project.active_assignment_count %> active assignments</div>
                </td>
                <td><%= project.branch_name || 'Unassigned' %></td>
                <td><%= project.project_manager_name || 'Unassigned' %></td>
                <td><%= project.budget ? Number(project.budget).toLocaleString() : '-' %></td>
                <td><%= new Date(project.start_date).toLocaleDateString() %></td>
                <td>
                  <span class="badge rounded-pill <%= project.status === 'active' ? 'badge-soft-success' : project.status === 'completed' ? 'badge-soft-primary' : project.status === 'on_hold' ? 'badge-soft-warning' : project.status === 'cancelled' ? 'badge-soft-danger' : 'badge-soft-secondary' %>">
                    <%= project.status %>
                  </span>
                </td>
                <td><%= project.completion_percentage %>%</td>
                <td class="text-end">
                  <a href="/projects/<%= project.id %>" class="btn btn-sm btn-outline-primary">View</a>
                  <a href="/projects/<%= project.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
