<section class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h1 class="h4 mb-1">Payroll Runs</h1>
    <p class="text-muted mb-0">Generate, review, approve, and mark payroll runs as paid.</p>
  </div>
  <div class="d-flex gap-2">
    <% if (canManagePayroll) { %>
      <a class="btn btn-outline-secondary" href="/payroll/settings">Settings</a>
      <a class="btn btn-outline-secondary" href="/payroll/compensation">Compensation</a>
      <a class="btn btn-success" href="/payroll/runs/generate">Generate Payroll</a>
    <% } %>
  </div>
</section>

<section class="alert alert-info border-0 shadow-sm">
  Payroll items are generated automatically when a payroll run is created. To prepare payroll, first set staff compensation, allowances, and deductions. After generation, payroll items can be reviewed inside the payroll run detail page.
</section>

<section class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Month / Year</th>
          <th>Status</th>
          <th>Gross Total</th>
          <th>Deductions</th>
          <th>Net Total</th>
          <th>Generated By</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="7" class="text-center text-muted py-5">No payroll runs generated yet.</td></tr>
        <% } %>
        <% rows.forEach((run) => { %>
          <tr>
            <td><%= run.payroll_month %>/<%= run.payroll_year %></td>
            <td><span class="badge text-bg-<%= statusBadge(run.status) %> text-capitalize"><%= run.status %></span></td>
            <td>NLe <%= money(run.total_gross) %></td>
            <td>NLe <%= money(run.total_deductions) %></td>
            <td>NLe <%= money(run.total_net) %></td>
            <td><%= run.generated_by_name || 'System' %></td>
            <td class="text-end"><a class="btn btn-sm btn-outline-success" href="/payroll/runs/<%= run.id %>">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
