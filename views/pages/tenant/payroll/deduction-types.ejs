<section class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h1 class="h4 mb-1">Deduction Types</h1>
    <p class="text-muted mb-0">Define reusable deductions that can be assigned to staff.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/payroll/compensation">Back to Compensation</a>
</section>

<div class="row g-4">
  <div class="col-lg-4">
    <section class="card border-0 shadow-sm">
      <div class="card-body">
        <h2 class="h5">Create Deduction Type</h2>
        <% if (validationErrors && validationErrors.length) { %>
          <div class="alert alert-danger">
            <% validationErrors.forEach((error) => { %><div><%= error.msg %></div><% }) %>
          </div>
        <% } %>
        <form method="post" action="/payroll/deduction-types" class="row g-3">
          <div class="col-12">
            <label class="form-label">Name</label>
            <input class="form-control" name="name" value="<%= formData.name %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Code</label>
            <input class="form-control" name="code" value="<%= formData.code %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Default Amount</label>
            <input class="form-control" name="default_amount" type="number" min="0" step="0.01" value="<%= formData.default_amount %>" required>
          </div>
          <div class="col-12">
            <label class="form-label">Calculation Type</label>
            <select class="form-select" name="calculation_type">
              <% calculationTypeOptions.forEach((option) => { %>
                <option value="<%= option.value %>" <%= formData.calculation_type === option.value ? 'selected' : '' %>><%= option.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label">Description</label>
            <textarea class="form-control" name="description" rows="3"><%= formData.description %></textarea>
          </div>
          <div class="col-12">
            <select class="form-select" name="status">
              <% statusOptions.forEach((status) => { %>
                <option value="<%= status %>"><%= status %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12"><button class="btn btn-success" type="submit">Create Deduction</button></div>
        </form>
      </div>
    </section>
  </div>
  <div class="col-lg-8">
    <section class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light"><tr><th>Name</th><th>Code</th><th>Type</th><th>Default</th><th>Status</th><th>Edit</th></tr></thead>
          <tbody>
            <% if (!types.length) { %>
              <tr><td colspan="6" class="text-center text-muted py-5">No deduction types yet.</td></tr>
            <% } %>
            <% types.forEach((type) => { %>
              <tr>
                <form method="post" action="/payroll/deduction-types/<%= type.id %>/edit">
                  <td><input class="form-control form-control-sm" name="name" value="<%= type.name %>" required></td>
                  <td><input class="form-control form-control-sm" name="code" value="<%= type.code %>" required></td>
                  <td>
                    <select class="form-select form-select-sm" name="calculation_type">
                      <% calculationTypeOptions.forEach((option) => { %>
                        <option value="<%= option.value %>" <%= type.calculation_type === option.value ? 'selected' : '' %>><%= option.label %></option>
                      <% }) %>
                    </select>
                  </td>
                  <td><input class="form-control form-control-sm" name="default_amount" type="number" min="0" step="0.01" value="<%= type.default_amount %>"></td>
                  <td>
                    <input type="hidden" name="description" value="<%= type.description || '' %>">
                    <select class="form-select form-select-sm" name="status">
                      <% statusOptions.forEach((status) => { %>
                        <option value="<%= status %>" <%= type.status === status ? 'selected' : '' %>><%= status %></option>
                      <% }) %>
                    </select>
                  </td>
                  <td><button class="btn btn-sm btn-outline-success" type="submit">Save</button></td>
                </form>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
