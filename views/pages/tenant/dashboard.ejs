<section class="mb-4">
  <div class="row g-3">
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Staff &amp; Volunteers</div>
          <div class="display-6 fw-semibold"><%= stats.activeStaffCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Total Branches</div>
          <div class="display-6 fw-semibold"><%= stats.totalBranches %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Today's Attendance</div>
          <div class="display-6 fw-semibold"><%= stats.todayAttendanceCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Today's Self Check-Ins</div>
          <div class="display-6 fw-semibold"><%= stats.todaySelfCheckins %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Active Projects</div>
          <div class="display-6 fw-semibold"><%= stats.activeProjectCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Completed Projects</div>
          <div class="display-6 fw-semibold"><%= stats.completedProjectCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Staff Assigned</div>
          <div class="display-6 fw-semibold"><%= stats.assignedProjectStaffCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Overdue Tasks</div>
          <div class="display-6 fw-semibold"><%= stats.overdueTaskCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Submitted Reports</div>
          <div class="display-6 fw-semibold"><%= stats.submittedReportCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Pending Report Approvals</div>
          <div class="display-6 fw-semibold"><%= stats.pendingReportApprovalsCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Approved Reports This Month</div>
          <div class="display-6 fw-semibold"><%= stats.approvedReportsThisMonthCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Beneficiaries This Month</div>
          <div class="display-6 fw-semibold"><%= stats.beneficiariesReachedThisMonth %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Current Month Payroll</div>
          <div class="display-6 fw-semibold text-capitalize"><%= stats.currentMonthPayrollStatus.replace('_', ' ') %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Net Payroll This Month</div>
          <div class="display-6 fw-semibold">NLe <%= Number(stats.currentMonthPayrollNet || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Pending Payroll Approval</div>
          <div class="display-6 fw-semibold"><%= stats.pendingPayrollApprovalCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Expenses This Month</div>
          <div class="display-6 fw-semibold"><%= stats.expensesThisMonthCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Pending Expense Approvals</div>
          <div class="display-6 fw-semibold"><%= stats.pendingExpenseApprovalsCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Approved Expenses This Month</div>
          <div class="display-6 fw-semibold">NLe <%= Number(stats.approvedExpensesThisMonth || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Project Budget Utilization</div>
          <div class="display-6 fw-semibold"><%= stats.projectBudgetUtilization %>%</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Pending Attendance Approvals</div>
          <div class="display-6 fw-semibold"><%= stats.pendingAttendanceApprovalsCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Outside Geofence Attempts</div>
          <div class="display-6 fw-semibold"><%= stats.outsideGeofenceAttempts %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Departments</div>
          <div class="display-6 fw-semibold"><%= stats.departmentCount %></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="card border-0 shadow-sm">
  <div class="card-body">
    <h2 class="h5">Tenant Administration Overview</h2>
    <p class="text-muted mb-0">
      Active volunteers: <strong><%= stats.activeVolunteerCount %></strong>. Active users: <strong><%= stats.activeUserCount %></strong>. Approval workflows configured: <strong><%= stats.workflowCount %></strong>. Audit entries recorded for this tenant: <strong><%= stats.auditLogCount %></strong>. Business modules will be added in future phases.
    </p>
  </div>
</section>
