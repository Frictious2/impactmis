<section class="mb-4">
  <div class="row g-3">
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Staff &amp; Volunteers</div>
          <div class="display-6 fw-semibold"><%= stats.activeStaffCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Today's Attendance</div>
          <div class="display-6 fw-semibold"><%= stats.todayAttendanceCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Pending Attendance Approvals</div>
          <div class="display-6 fw-semibold"><%= stats.pendingAttendanceApprovalsCount %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm stat-card">
        <div class="card-body">
          <div class="text-muted small">Departments</div>
          <div class="display-6 fw-semibold"><%= stats.departmentCount %></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="card border-0 shadow-sm">
  <div class="card-body">
    <h2 class="h5">Tenant Administration Overview</h2>
    <p class="text-muted mb-0">
      Active volunteers: <strong><%= stats.activeVolunteerCount %></strong>. Active users: <strong><%= stats.activeUserCount %></strong>. Approval workflows configured: <strong><%= stats.workflowCount %></strong>. Audit entries recorded for this tenant: <strong><%= stats.auditLogCount %></strong>. Business modules will be added in future phases.
    </p>
  </div>
</section>
