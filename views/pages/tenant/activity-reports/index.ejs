<section class="card section-card mb-4">
  <div class="card-body">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
      <div>
        <h1 class="h4 mb-1">Activity Reports</h1>
        <p class="text-muted mb-0">Capture field activity, beneficiary reach, and basic M&amp;E evidence by project.</p>
      </div>
      <div>
        <a href="/activity-reports/create" class="btn btn-primary">Create Activity Report</a>
      </div>
    </div>

    <form method="GET" action="/activity-reports" class="row g-3 align-items-end">
      <div class="col-md-3">
        <label for="project_id" class="form-label">Project</label>
        <select id="project_id" name="project_id" class="form-select">
          <option value="">All</option>
          <% projects.forEach((project) => { %>
            <option value="<%= project.id %>" <%= String(filters.project_id) === String(project.id) ? 'selected' : '' %>><%= project.project_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="branch_id" class="form-label">Branch</label>
        <select id="branch_id" name="branch_id" class="form-select">
          <option value="">All</option>
          <% branches.forEach((branch) => { %>
            <option value="<%= branch.id %>" <%= String(filters.branch_id) === String(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="staff_member_id" class="form-label">Staff Member</label>
        <select id="staff_member_id" name="staff_member_id" class="form-select">
          <option value="">All</option>
          <% staffMembers.forEach((staffMember) => { %>
            <option value="<%= staffMember.id %>" <%= String(filters.staff_member_id) === String(staffMember.id) ? 'selected' : '' %>><%= staffMember.full_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="report_type" class="form-label">Report Type</label>
        <select id="report_type" name="report_type" class="form-select">
          <option value="">All</option>
          <% reportTypeOptions.forEach((option) => { %>
            <option value="<%= option.value %>" <%= filters.report_type === option.value ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="status" class="form-label">Status</label>
        <select id="status" name="status" class="form-select">
          <option value="">All</option>
          <% statusOptions.forEach((option) => { %>
            <option value="<%= option.value %>" <%= filters.status === option.value ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="date_from" class="form-label">Date From</label>
        <input id="date_from" name="date_from" type="date" class="form-control" value="<%= filters.date_from %>" />
      </div>
      <div class="col-md-3">
        <label for="date_to" class="form-label">Date To</label>
        <input id="date_to" name="date_to" type="date" class="form-control" value="<%= filters.date_to %>" />
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-dark flex-grow-1">Filter</button>
        <a href="/activity-reports" class="btn btn-outline-secondary">Reset</a>
      </div>
    </form>
  </div>
</section>

<section class="card section-card">
  <div class="card-body p-0">
    <% if (!reports.length) { %>
      <div class="p-4">
        <h2 class="h5">No activity reports found</h2>
        <p class="text-muted mb-3">Create the first activity report for this tenant.</p>
        <a href="/activity-reports/create" class="btn btn-primary">Create Activity Report</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Report Code</th>
              <th>Title</th>
              <th>Project</th>
              <th>Type</th>
              <th>Report Date</th>
              <th>Beneficiaries</th>
              <th>Status</th>
              <th>Submitted By</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% reports.forEach((report) => { %>
              <tr>
                <td class="fw-semibold"><%= report.report_code %></td>
                <td><%= report.title %></td>
                <td><%= report.project_name %></td>
                <td><%= report.report_type %></td>
                <td><%= new Date(report.report_date).toLocaleDateString() %></td>
                <td><%= report.beneficiaries_reached %></td>
                <td>
                  <span class="badge rounded-pill <%= report.status === 'approved' ? 'badge-soft-success' : report.status === 'rejected' ? 'badge-soft-danger' : report.status === 'submitted' ? 'badge-soft-warning' : 'badge-soft-secondary' %>">
                    <%= report.status %>
                  </span>
                </td>
                <td><%= report.submitted_by_name || 'System' %></td>
                <td class="text-end">
                  <a href="/activity-reports/<%= report.id %>" class="btn btn-sm btn-outline-primary">View</a>
                  <a href="/activity-reports/<%= report.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
