<%
  const safeAttachments = Array.isArray(attachments) ? attachments : [];
  const safeIndicatorUpdates = Array.isArray(indicatorUpdates) ? indicatorUpdates : [];
  const safeActivity = Array.isArray(activity) ? activity : [];
  const canTakeApprovalAction = canApprove && report.status === 'submitted';
%>

<section class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1"><%= report.title %></h1>
    <div class="d-flex flex-wrap gap-2">
      <span class="badge rounded-pill badge-soft-secondary"><%= report.report_code %></span>
      <span class="badge rounded-pill badge-soft-secondary"><%= report.report_type %></span>
      <span class="badge rounded-pill <%= report.status === 'approved' ? 'badge-soft-success' : report.status === 'rejected' ? 'badge-soft-danger' : report.status === 'submitted' ? 'badge-soft-warning' : 'badge-soft-secondary' %>"><%= report.status %></span>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a href="/activity-reports/<%= report.id %>/edit" class="btn btn-primary">Edit</a>
    <a href="/activity-reports" class="btn btn-outline-secondary">Back to List</a>
  </div>
</section>

<section class="card section-card mb-4">
  <div class="card-body">
    <ul class="nav nav-tabs mb-4">
      <li class="nav-item"><a class="nav-link <%= activeTab === 'overview' ? 'active' : '' %>" href="/activity-reports/<%= report.id %>?tab=overview">Overview</a></li>
      <li class="nav-item"><a class="nav-link <%= activeTab === 'attachments' ? 'active' : '' %>" href="/activity-reports/<%= report.id %>?tab=attachments">Attachments</a></li>
      <li class="nav-item"><a class="nav-link <%= activeTab === 'approval' ? 'active' : '' %>" href="/activity-reports/<%= report.id %>?tab=approval">Approval</a></li>
      <li class="nav-item"><a class="nav-link <%= activeTab === 'indicator-updates' ? 'active' : '' %>" href="/activity-reports/<%= report.id %>?tab=indicator-updates">Indicator Updates</a></li>
      <li class="nav-item"><a class="nav-link <%= activeTab === 'activity' ? 'active' : '' %>" href="/activity-reports/<%= report.id %>?tab=activity">Activity/Audit</a></li>
    </ul>

    <% if (activeTab === 'overview') { %>
      <div class="row g-4">
        <div class="col-xl-6">
          <section class="border rounded-3 p-3 h-100">
            <h2 class="h5 mb-3">Report Summary</h2>
            <dl class="row mb-0">
              <dt class="col-sm-5">Project</dt>
              <dd class="col-sm-7"><a href="/projects/<%= report.project_id %>"><%= report.project_name %></a></dd>
              <dt class="col-sm-5">Task</dt>
              <dd class="col-sm-7"><%= report.task_title || 'Not linked' %></dd>
              <dt class="col-sm-5">Branch</dt>
              <dd class="col-sm-7"><%= report.branch_name || 'Not linked' %></dd>
              <dt class="col-sm-5">Staff</dt>
              <dd class="col-sm-7"><%= report.staff_name || 'Not linked' %></dd>
              <dt class="col-sm-5">Report Date</dt>
              <dd class="col-sm-7"><%= new Date(report.report_date).toLocaleDateString() %></dd>
              <dt class="col-sm-5">Submitted By</dt>
              <dd class="col-sm-7"><%= report.submitted_by_name || 'System' %></dd>
            </dl>
          </section>
        </div>
        <div class="col-xl-6">
          <section class="border rounded-3 p-3 h-100">
            <h2 class="h5 mb-3">Beneficiary Breakdown</h2>
            <dl class="row mb-0">
              <dt class="col-sm-5">Total Reached</dt>
              <dd class="col-sm-7"><%= report.beneficiaries_reached %></dd>
              <dt class="col-sm-5">Male</dt>
              <dd class="col-sm-7"><%= report.male_beneficiaries %></dd>
              <dt class="col-sm-5">Female</dt>
              <dd class="col-sm-7"><%= report.female_beneficiaries %></dd>
              <dt class="col-sm-5">Youth</dt>
              <dd class="col-sm-7"><%= report.youth_beneficiaries %></dd>
            </dl>
          </section>
        </div>
        <div class="col-12">
          <section class="border rounded-3 p-3">
            <h2 class="h5 mb-3">Narrative</h2>
            <p><strong>Summary:</strong> <%= report.summary %></p>
            <p><strong>Activities Completed:</strong> <%= report.activities_completed || '-' %></p>
            <p><strong>Challenges:</strong> <%= report.challenges || '-' %></p>
            <p class="mb-0"><strong>Recommendations:</strong> <%= report.recommendations || '-' %></p>
          </section>
        </div>
      </div>
    <% } %>

    <% if (activeTab === 'attachments') { %>
      <div class="row g-4">
        <div class="col-lg-5">
          <section class="border rounded-3 p-3 h-100">
            <h2 class="h5 mb-3">Upload Attachment</h2>
            <form action="/activity-reports/<%= report.id %>/attachments" method="POST" enctype="multipart/form-data" class="d-flex flex-column gap-3">
              <div>
                <label for="attachment" class="form-label">Image or PDF</label>
                <input id="attachment" name="attachment" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                <div class="form-text">Allowed: JPEG, PNG, WEBP, PDF. Max size 5MB.</div>
              </div>
              <button type="submit" class="btn btn-primary">Upload</button>
            </form>
          </section>
        </div>
        <div class="col-lg-7">
          <section class="border rounded-3 p-3 h-100">
            <h2 class="h5 mb-3">Attachments</h2>
            <% if (!safeAttachments.length) { %>
              <p class="text-muted mb-0">No attachments uploaded yet.</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>File</th>
                      <th>Type</th>
                      <th>Size</th>
                      <th>Uploaded</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% safeAttachments.forEach((attachment) => { %>
                      <tr>
                        <td><a href="<%= attachment.file_path %>" target="_blank" rel="noopener noreferrer"><%= attachment.original_name %></a></td>
                        <td><%= attachment.mime_type %></td>
                        <td><%= Math.round(attachment.file_size / 1024) %> KB</td>
                        <td>
                          <div><%= new Date(attachment.created_at).toLocaleString() %></div>
                          <div class="small text-muted"><%= attachment.uploaded_by_name || 'System' %></div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </section>
        </div>
      </div>
    <% } %>

    <% if (activeTab === 'approval') { %>
      <div class="row g-4">
        <div class="col-lg-6">
          <section class="border rounded-3 p-3 h-100">
            <h2 class="h5 mb-3">Approval Status</h2>
            <dl class="row mb-0">
              <dt class="col-sm-5">Status</dt>
              <dd class="col-sm-7">
                <span class="badge rounded-pill <%= report.status === 'approved' ? 'badge-soft-success' : report.status === 'rejected' ? 'badge-soft-danger' : report.status === 'submitted' ? 'badge-soft-warning' : 'badge-soft-secondary' %>"><%= report.status %></span>
              </dd>
              <dt class="col-sm-5">Approved By</dt>
              <dd class="col-sm-7"><%= report.approved_by_name || 'Not yet approved' %></dd>
              <dt class="col-sm-5">Approved At</dt>
              <dd class="col-sm-7"><%= report.approved_at ? new Date(report.approved_at).toLocaleString() : '-' %></dd>
              <dt class="col-sm-5">Rejection Reason</dt>
              <dd class="col-sm-7"><%= report.rejection_reason || '-' %></dd>
            </dl>
          </section>
        </div>
        <div class="col-lg-6">
          <section class="border rounded-3 p-3 h-100">
            <h2 class="h5 mb-3">Actions</h2>
            <div class="d-flex flex-column gap-3">
              <% if (report.status !== 'submitted') { %>
                <form action="/activity-reports/<%= report.id %>/submit" method="POST">
                  <button type="submit" class="btn btn-outline-dark">Submit Report</button>
                </form>
              <% } %>
              <% if (canTakeApprovalAction) { %>
                <form action="/activity-reports/<%= report.id %>/approve" method="POST">
                  <button type="submit" class="btn btn-success">Approve Report</button>
                </form>
                <form action="/activity-reports/<%= report.id %>/reject" method="POST" class="d-flex flex-column gap-2">
                  <input name="rejection_reason" type="text" class="form-control" placeholder="Reason for rejection" />
                  <button type="submit" class="btn btn-outline-danger">Reject Report</button>
                </form>
              <% } else if (canApprove) { %>
                <p class="text-muted mb-0">Only submitted reports can be approved or rejected.</p>
              <% } else { %>
                <p class="text-muted mb-0">You do not have permission to approve or reject this report.</p>
              <% } %>
            </div>
          </section>
        </div>
      </div>
    <% } %>

    <% if (activeTab === 'indicator-updates') { %>
      <% if (!safeIndicatorUpdates.length) { %>
        <p class="text-muted mb-0">No indicator updates have been linked to this report yet.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Indicator</th>
                <th>Update Value</th>
                <th>Notes</th>
                <th>When</th>
              </tr>
            </thead>
            <tbody>
              <% safeIndicatorUpdates.forEach((update) => { %>
                <tr>
                  <td><%= update.indicator_name %></td>
                  <td><%= update.update_value %></td>
                  <td><%= update.notes || '-' %></td>
                  <td><%= new Date(update.created_at).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } %>

    <% if (activeTab === 'activity') { %>
      <% if (!safeActivity.length) { %>
        <p class="text-muted mb-0">No audit activity has been recorded for this report yet.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Action</th>
                <th>Actor</th>
                <th>Metadata</th>
                <th>When</th>
              </tr>
            </thead>
            <tbody>
              <% safeActivity.forEach((log) => { %>
                <tr>
                  <td><%= log.action %></td>
                  <td><%= log.user_name || 'System' %></td>
                  <td><code class="small"><%= log.metadata_json ? JSON.stringify(log.metadata_json) : '-' %></code></td>
                  <td><%= new Date(log.created_at).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } %>
  </div>
</section>
