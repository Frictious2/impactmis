<section class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h1 class="h4 mb-1">Inbox</h1>
    <p class="text-muted mb-0">Messages sent to you inside ImpactMIS.</p>
  </div>
  <div class="d-flex gap-2">
    <% if (currentUser.role !== 'Donor') { %><a class="btn btn-success" href="/messages/create">Compose</a><% } %>
    <a class="btn btn-outline-secondary" href="/messages/sent">Sent</a>
  </div>
</section>

<section class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>Sender</th><th>Subject</th><th>Date</th><th>Status</th><th class="text-end">Action</th></tr></thead>
      <tbody>
        <% if (!messages.length) { %><tr><td colspan="5" class="text-center text-muted py-5">Your inbox is empty.</td></tr><% } %>
        <% messages.forEach((message) => { %>
          <tr class="<%= message.is_read ? '' : 'table-warning' %>">
            <td><%= message.sender_name %> <span class="text-muted">(<%= message.sender_role %>)</span></td>
            <td><%= message.subject %></td>
            <td><%= new Date(message.created_at).toLocaleString() %></td>
            <td><span class="badge text-bg-<%= message.is_read ? 'secondary' : 'danger' %>"><%= message.is_read ? 'Read' : 'Unread' %></span></td>
            <td class="text-end"><a class="btn btn-sm btn-outline-success" href="/messages/<%= message.id %>">Open</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
