<section class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start mb-4">
      <div>
        <h1 class="h4 mb-1"><%= message.subject %></h1>
        <p class="text-muted mb-0">
          From <strong><%= message.sender_name %></strong> to <strong><%= message.recipient_name %></strong>
          · <%= new Date(message.created_at).toLocaleString() %>
        </p>
      </div>
      <a class="btn btn-outline-secondary" href="/messages">Back to Inbox</a>
    </div>
    <div class="border rounded p-4 bg-light text-break">
      <%= message.body %>
    </div>
    <% if (Number(message.recipient_user_id) === Number(currentUser.id) && !message.is_read) { %>
      <form method="post" action="/messages/<%= message.id %>/read" class="mt-3">
        <button class="btn btn-outline-success" type="submit">Mark Read</button>
      </form>
    <% } %>
  </div>
</section>
