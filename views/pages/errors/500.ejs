<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../../partials/head", { pageTitle }) %>
  </head>
  <body class="bg-body-tertiary">
    <main class="container py-5">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h1 class="h3">500</h1>
          <p class="text-muted">Something went wrong while processing your request.</p>
          <% if (errorMessage) { %>
            <pre class="bg-light p-3 rounded small mb-0"><%= errorMessage %></pre>
          <% } %>
        </div>
      </div>
    </main>
    <%- include("../../partials/footer") %>
  </body>
</html>
