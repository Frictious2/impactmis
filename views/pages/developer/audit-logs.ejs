<section class="card section-card">
  <div class="card-body">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
      <div>
        <h1 class="h4 mb-1">System / Developer Audit Logs</h1>
        <p class="text-muted mb-0">Shows system-wide, developer, and tenant-related platform activity.</p>
      </div>
      <div class="text-muted small">
        <%= pagination.totalLogs %> result<%= pagination.totalLogs === 1 ? '' : 's' %>
      </div>
    </div>

    <form method="get" action="/developer/audit-logs" class="row g-3 mb-4">
      <div class="col-md-3">
        <label class="form-label" for="tenant_id">Tenant</label>
        <select class="form-select" id="tenant_id" name="tenant_id">
          <option value="">All tenants and system logs</option>
          <% tenants.forEach((tenant) => { %>
            <option value="<%= tenant.id %>" <%= String(filters.tenant_id) === String(tenant.id) ? 'selected' : '' %>>
              <%= tenant.name %> (<%= tenant.tenant_code %>)
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label" for="action">Action prefix</label>
        <input class="form-control" id="action" name="action" value="<%= filters.action %>" placeholder="license.">
      </div>
      <div class="col-md-2">
        <label class="form-label" for="entity_type">Entity Type</label>
        <input class="form-control" id="entity_type" name="entity_type" value="<%= filters.entity_type %>" placeholder="tenant">
      </div>
      <div class="col-md-2">
        <label class="form-label" for="date_from">From</label>
        <input class="form-control" id="date_from" name="date_from" type="date" value="<%= filters.date_from %>">
      </div>
      <div class="col-md-2">
        <label class="form-label" for="date_to">To</label>
        <input class="form-control" id="date_to" name="date_to" type="date" value="<%= filters.date_to %>">
      </div>
      <div class="col-md-1">
        <label class="form-label" for="limit">Limit</label>
        <select class="form-select" id="limit" name="limit">
          <% [25, 50, 100, 200].forEach((limitOption) => { %>
            <option value="<%= limitOption %>" <%= pagination.limit === limitOption ? 'selected' : '' %>><%= limitOption %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Filter</button>
        <a class="btn btn-outline-secondary" href="/developer/audit-logs">Reset</a>
      </div>
    </form>

    <% if (!logs.length) { %>
      <p class="text-muted mb-0">No audit logs found.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Action</th>
              <th>Tenant</th>
              <th>Actor</th>
              <th>Entity</th>
              <th>Metadata</th>
              <th>When</th>
            </tr>
          </thead>
          <tbody>
            <% logs.forEach((log) => { %>
              <tr>
                <td><span class="fw-semibold"><%= log.action %></span></td>
                <td><%= log.tenant_name || 'System / Developer' %></td>
                <td><%= log.user_name || 'System' %></td>
                <td><%= log.entity_type %> <%= log.entity_id ? `#${log.entity_id}` : '' %></td>
                <td><code class="small"><%= log.metadata_json ? JSON.stringify(log.metadata_json) : '-' %></code></td>
                <td><%= new Date(log.created_at).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% const queryBase = new URLSearchParams({
        tenant_id: filters.tenant_id || '',
        action: filters.action || '',
        entity_type: filters.entity_type || '',
        date_from: filters.date_from || '',
        date_to: filters.date_to || '',
        limit: String(pagination.limit)
      }); %>
      <nav class="d-flex justify-content-between align-items-center mt-4" aria-label="Audit log pagination">
        <div class="small text-muted">Page <%= pagination.page %> of <%= pagination.totalPages %></div>
        <div class="btn-group">
          <% queryBase.set('page', String(Math.max(pagination.page - 1, 1))); %>
          <a class="btn btn-outline-secondary <%= pagination.hasPrevious ? '' : 'disabled' %>" href="/developer/audit-logs?<%= queryBase.toString() %>">Previous</a>
          <% queryBase.set('page', String(Math.min(pagination.page + 1, pagination.totalPages))); %>
          <a class="btn btn-outline-secondary <%= pagination.hasNext ? '' : 'disabled' %>" href="/developer/audit-logs?<%= queryBase.toString() %>">Next</a>
        </div>
      </nav>
    <% } %>
  </div>
</section>
