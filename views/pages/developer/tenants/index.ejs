<section class="card section-card mb-4">
  <div class="card-body">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
      <div>
        <h1 class="h4 mb-1">Tenants</h1>
        <p class="text-muted mb-0">Manage NGO/CBO onboarding, licensing, and tenant access from one place.</p>
      </div>
      <div>
        <a href="/developer/tenants/create" class="btn btn-primary">Create Tenant</a>
      </div>
    </div>

    <form method="GET" action="/developer/tenants" class="row g-3 align-items-end">
      <div class="col-12 col-lg-5">
        <label for="search" class="form-label">Search</label>
        <input
          id="search"
          name="search"
          type="text"
          class="form-control"
          placeholder="Name, tenant code, or contact email"
          value="<%= filters.search %>"
        />
      </div>
      <div class="col-12 col-md-3 col-lg-2">
        <label for="status" class="form-label">Tenant Status</label>
        <select id="status" name="status" class="form-select">
          <option value="">All</option>
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
        </select>
      </div>
      <div class="col-12 col-md-3 col-lg-2">
        <label for="license" class="form-label">License</label>
        <select id="license" name="license" class="form-select">
          <option value="">All</option>
          <option value="active" <%= filters.license === 'active' ? 'selected' : '' %>>Active</option>
          <option value="expired" <%= filters.license === 'expired' ? 'selected' : '' %>>Expired</option>
          <option value="no_license" <%= filters.license === 'no_license' ? 'selected' : '' %>>No License</option>
        </select>
      </div>
      <div class="col-12 col-md-6 col-lg-3 d-flex gap-2">
        <button type="submit" class="btn btn-dark flex-grow-1">Apply Filters</button>
        <a href="/developer/tenants" class="btn btn-outline-secondary">Reset</a>
      </div>
    </form>
  </div>
</section>

<section class="card section-card table-card">
  <div class="card-body p-0">
    <% if (!tenants.length) { %>
      <div class="p-4">
        <h2 class="h5">No tenants found</h2>
        <p class="text-muted mb-3">Try adjusting your filters or create the first tenant account.</p>
        <a href="/developer/tenants/create" class="btn btn-primary">Create Tenant</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Tenant</th>
              <th>Contact</th>
              <th>Status</th>
              <th>License</th>
              <th>Expiry</th>
              <th>Created</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% tenants.forEach((tenant) => { %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= tenant.name %></div>
                  <div class="small text-muted"><%= tenant.tenant_code %> · <%= tenant.slug %></div>
                  <div class="small text-muted"><%= tenant.primary_domain || 'No primary domain' %></div>
                </td>
                <td>
                  <div><%= tenant.contact_email || 'No contact email' %></div>
                </td>
                <td>
                  <span class="badge rounded-pill <%= tenant.status === 'active' ? 'badge-soft-success' : 'badge-soft-danger' %>">
                    <%= tenant.status %>
                  </span>
                </td>
                <td>
                  <% if (tenant.license_state === 'active') { %>
                    <span class="badge rounded-pill badge-soft-success">Active</span>
                  <% } else if (tenant.license_state === 'expired') { %>
                    <span class="badge rounded-pill badge-soft-warning">Expired</span>
                  <% } else { %>
                    <span class="badge rounded-pill badge-soft-secondary">No License</span>
                  <% } %>
                </td>
                <td><%= tenant.latest_license_expires_at ? new Date(tenant.latest_license_expires_at).toLocaleDateString() : '—' %></td>
                <td><%= new Date(tenant.created_at).toLocaleDateString() %></td>
                <td class="text-end">
                  <a href="/developer/tenants/<%= tenant.id %>" class="btn btn-sm btn-outline-primary">View</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
