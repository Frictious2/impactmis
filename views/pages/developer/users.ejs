<section class="card section-card">
  <div class="card-body">
    <div class="mb-4">
      <h1 class="h4 mb-1">Developer Users</h1>
      <p class="text-muted mb-0">Platform-level Developer/Super Admin accounts only. Tenant users are managed inside each organization.</p>
    </div>

    <% if (!developerUsers.length) { %>
      <p class="text-muted mb-0">No developer users found.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th>Must Change Password</th>
              <th>Last Login</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% developerUsers.forEach((user) => { %>
              <tr>
                <td class="fw-semibold"><%= user.full_name %></td>
                <td><%= user.email %></td>
                <td><%= user.role %></td>
                <td>
                  <span class="badge rounded-pill <%= user.status === 'active' ? 'badge-soft-success' : 'badge-soft-danger' %>">
                    <%= user.status %>
                  </span>
                </td>
                <td><%= user.must_change_password ? 'Yes' : 'No' %></td>
                <td><%= user.last_login_at ? new Date(user.last_login_at).toLocaleString() : 'Never' %></td>
                <td><%= new Date(user.created_at).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
