<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <div class="mb-4">
          <div class="text-uppercase small text-success fw-semibold">ImpactMIS</div>
          <h1 class="h4 mb-1">Change Password</h1>
          <p class="text-muted mb-0">Set a new password before continuing.</p>
        </div>

        <% if (authError) { %>
          <div class="alert alert-danger"><%= authError %></div>
        <% } %>

        <% if (validationErrors && validationErrors.length) { %>
          <div class="alert alert-danger">
            <% validationErrors.forEach((error) => { %>
              <div><%= error.msg %></div>
            <% }) %>
          </div>
        <% } %>

        <form method="post" action="/change-password" class="d-flex flex-column gap-3">
          <div>
            <label class="form-label" for="current_password">Current Password</label>
            <input class="form-control" id="current_password" name="current_password" type="password" autocomplete="current-password" required>
          </div>
          <div>
            <label class="form-label" for="new_password">New Password</label>
            <input class="form-control" id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="8" required>
          </div>
          <div>
            <label class="form-label" for="confirm_password">Confirm New Password</label>
            <input class="form-control" id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="8" required>
          </div>
          <button class="btn btn-success w-100" type="submit">Update Password</button>
        </form>

        <form method="post" action="/logout" class="mt-3">
          <button class="btn btn-link text-muted w-100" type="submit">Logout instead</button>
        </form>
      </div>
    </div>
  </div>
</div>
