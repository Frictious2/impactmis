<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4 p-lg-5">
        <div class="text-center mb-4">
          <h1 class="h3 mb-2">Sign in to ImpactMIS</h1>
          <p class="text-muted mb-0">Developer and tenant users sign in from the same portal.</p>
        </div>

        <%- include("../../partials/flash") %>

        <% if (typeof authError !== 'undefined' && authError) { %>
          <div class="alert alert-danger"><%= authError %></div>
        <% } %>

        <% if (typeof validationErrors !== 'undefined' && validationErrors.length) { %>
          <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
              <% validationErrors.forEach((error) => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/login" method="POST" novalidate>
          <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              class="form-control"
              value="<%= formData?.email || '' %>"
              required
            />
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input id="password" name="password" type="password" class="form-control" required />
          </div>

          <button type="submit" class="btn btn-primary w-100">Log In</button>
        </form>
      </div>
    </div>
  </div>
</div>
