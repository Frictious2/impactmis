<header class="border-bottom bg-white px-4 py-3">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
      <div class="fw-semibold"><%= pageTitle %></div>
      <div class="small text-muted d-flex flex-wrap align-items-center gap-2">
        <span><%= currentTenant ? currentTenant.name : 'Organization' %></span>
        <% if (currentUser) { %>
          <span>Signed in as <%= currentUser.full_name %></span>
          <span class="badge rounded-pill text-bg-secondary">Read-only Donor</span>
        <% } %>
      </div>
    </div>

    <% if (currentUser) { %>
      <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary btn-sm" href="/notifications">
          Notifications <span class="badge text-bg-danger"><%= unreadNotificationsCount || 0 %></span>
        </a>
        <a class="btn btn-outline-secondary btn-sm" href="/messages">
          Messages <span class="badge text-bg-danger"><%= unreadMessagesCount || 0 %></span>
        </a>
        <form action="/logout" method="POST" class="m-0">
          <button type="submit" class="btn btn-outline-secondary btn-sm">Log Out</button>
        </form>
      </div>
    <% } %>
  </div>
</header>
